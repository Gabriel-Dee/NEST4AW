# HTTPS with automatic Let's Encrypt certificates, plus plain-HTTP fallbacks on the IP.

# Staff web app
{$APP_DOMAIN} {
	encode gzip
	reverse_proxy frontend:3000
}

# API for the web app and the phone
{$API_DOMAIN} {
	request_body {
		max_size 9MB
	}
	reverse_proxy api:8000
}

# Fallback: web app over plain HTTP (camera scanning needs the HTTPS URL)
http://{$PUBLIC_IP} {
	encode gzip
	reverse_proxy frontend:3000
}

# Fallback: API over plain HTTP on the port the phone app already used
:8010 {
	request_body {
		max_size 9MB
	}
	reverse_proxy api:8000
}
